android_library {
    name: "FocusLock",
    static_libs: [
        "j.Lib",
    ],

    manifest: "src/main/AndroidManifest.xml",

    product_specific: true,

    srcs: [
        "src/main/java/**/*.kt",
        "src/main/java/**/*.java",
    ],

    resource_dirs: [
        "src/main/res",
    ],
    use_resource_processor: true,

    kotlincflags: ["-Xjvm-default=all"],
    sdk_version: "current",
    min_sdk_version: "30",
}
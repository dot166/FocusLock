<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <io.github.dot166.focuslock.ui.CompositeCircleViewLabeler
        android:id="@+id/composite_circle_view_labeler"
        android:layout_height="260dp"
        android:layout_width="match_parent">
        <io.github.dot166.focuslock.ui.CompositeCircleView
            android:id="@+id/composite_circle_view"
            android:layout_centerInParent="true"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginHorizontal="30dp"
            android:layout_marginVertical="40dp"/>
    </io.github.dot166.focuslock.ui.CompositeCircleViewLabeler>
    <Button
        android:id="@+id/more_button"
        android:layout_width="320dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:text="View App Usage"
        android:layout_below="@id/composite_circle_view_labeler"
        android:layout_centerHorizontal="true"
        style="?materialButtonOutlinedStyle"
        android:layout_height="wrap_content"/>
</RelativeLayout>
